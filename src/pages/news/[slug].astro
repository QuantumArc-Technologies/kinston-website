---
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import { articles } from '../../data/news';
import { breadcrumbLd, articleLd } from '../../lib/seo';

export function getStaticPaths() {
  return articles.map((a) => ({ params: { slug: a.slug }, props: { article: a } }));
}
const { article: a } = Astro.props;
const crumbs = [{ name: 'Home', href: '/' }, { name: 'News', href: '/news' }, { name: a.title, href: `/news/${a.slug}` }];
const fmtDate = (d: string) => new Date(d).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
const more = articles.filter((x) => x.slug !== a.slug).sort((x, y) => y.date.localeCompare(x.date)).slice(0, 3);
---
<Base title={a.title} description={a.excerpt} path={`/news/${a.slug}`} ogType="article" jsonLd={[breadcrumbLd(crumbs), articleLd(a)]}>
  <article>
    <PageHero eyebrow="KNOWLEDGE & INSIGHT" image={`/images/page-heroes/${a.category === 'Technical' ? 'quality-branded' : a.category === 'Product' ? 'products-branded' : a.category === 'Events' ? 'industries' : 'about-branded'}.webp`}>
<Breadcrumb items={crumbs.slice(0, 2)} light />
        <p class="meta"><span class="tag tag-orange">{a.category}</span><time datetime={a.date}>{fmtDate(a.date)}</time><span>{a.readingMinutes} min read</span></p>
        <h1>{a.title}</h1>
        <p class="lede">{a.excerpt}</p>
  </PageHero>
    <section class="section">
      <div class="wrap body">
        <div class="prose">
          {a.body.map((p) => <p>{p}</p>)}
        </div>
        <aside class="more">
          <h3>More from Kinston</h3>
          <ul>
            {more.map((m) => <li><a href={`/news/${m.slug}`}><span class="muted small">{fmtDate(m.date)}</span><strong>{m.title}</strong></a></li>)}
          </ul>
        </aside>
      </div>
    </section>
  </article>
  <CtaBand />
</Base>
<style>
  .meta { display: flex; align-items: center; gap: 14px; margin-top: 24px; font-size: var(--t-sm); color: #b7c0d2; }
  .page-head h1 { max-width: 22ch; }
  .body { display: grid; grid-template-columns: 1fr 320px; gap: 64px; align-items: start; }
  .prose { font-size: 1.125rem; }
  .prose p + p { margin-top: 1.2em; }
  .more { position: sticky; top: calc(36px + var(--header-h) + 24px); }
  .more h3 { margin-bottom: 12px; }
  .more li a { display: grid; gap: 2px; padding: 12px 0; border-top: 1px solid var(--zinc); }
  .more strong { font-weight: 500; line-height: 1.35; }
  .more li a:hover strong { color: var(--orange); }
  @media (max-width: 860px) { .body { grid-template-columns: 1fr; gap: 40px; } .more { position: static; } }
</style>
