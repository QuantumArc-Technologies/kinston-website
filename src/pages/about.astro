---
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CtaBand from '../components/CtaBand.astro';
import { breadcrumbLd } from '../lib/seo';

const crumbs = [{ name: 'Home', href: '/' }, { name: 'About', href: '/about' }];
---
<Base title="About KINSTON" description="KINSTON is an international lifting equipment brand delivering reliable, high-performance lifting and rigging solutions for demanding industrial applications." path="/about" jsonLd={[breadcrumbLd(crumbs)]}>
  <section class="page-head bg-ink">
    <div class="wrap">
      <Breadcrumb items={crumbs} light />
      <h1>About KINSTON</h1>
      <p class="lede">Engineered for Strength. Built for Safety.</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap about-intro">
      <SectionHeading title="Engineered for Strength. Built for Safety." />
      <div class="prose">
        <p>KINSTON is an international lifting equipment brand dedicated to delivering reliable, high-performance lifting and rigging solutions for demanding industrial applications.</p>
        <p>With a strong focus on engineering, quality, and safety, KINSTON offers a comprehensive range of lifting products, including shackles, master links, hooks, lifting chains, hoists, and rigging accessories.</p>
        <p>Working closely with qualified manufacturing partners, we focus on product specifications, material quality, manufacturing processes, testing, and traceability to ensure our products meet applicable international standards and customer requirements.</p>
        <p>Our solutions are developed to support the oil and gas, marine, offshore, construction, and heavy lifting industries.</p>
      </div>
    </div>
  </section>

  <section class="section bg-paper">
    <div class="wrap commitment">
      <SectionHeading title="Our commitment" />
      <p class="lede">At KINSTON, our commitment is simple:</p>
      <p class="promise">Quality Without Compromise,<br />Safety Without Exception</p>
    </div>
  </section>

  <CtaBand title="Work with KINSTON." body="Contact us to discuss lifting and rigging solutions for your industrial application." />
</Base>

<style>
  .about-intro { display: grid; grid-template-columns: 1fr 1.4fr; gap: 64px; align-items: start; }
  .commitment .lede { margin-bottom: 20px; }
  .promise { font-family: var(--font-display); font-weight: 700; font-size: clamp(1.75rem, 4vw, 3rem); line-height: 1.2; color: var(--navy); }
  @media (max-width: 900px) { .about-intro { grid-template-columns: 1fr; gap: 0; } }
</style>
