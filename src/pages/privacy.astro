---
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import PageHero from '../components/PageHero.astro';
import { site } from '../data/site';
const crumbs = [{ name: 'Home', href: '/' }, { name: 'Privacy policy', href: '/privacy' }];
---
<Base title="Privacy policy" description="How Kinston Lifting collects, uses and protects personal data submitted through this website." path="/privacy">
  <PageHero eyebrow="YOUR INFORMATION, PROTECTED">
<Breadcrumb items={crumbs} light /><h1>Privacy policy</h1><p class="lede">Last updated 1 September 2026.</p>
  </PageHero>
  <section class="section"><div class="wrap prose legal">
    <h2>Who we are</h2>
    <p>{site.legalName} ("Kinston", "we") operates this website. {/* Our head office is at Plot 14, Industrial Area 12, Sharjah, United Arab Emirates. For data questions email <a href={`mailto:privacy@kinstonlifting.com`}>privacy@kinstonlifting.com</a>. */}</p>
    <h2>What we collect</h2>
    <p>When you send an enquiry we collect your name, company, email address, telephone number and the content of your message. We use this to answer your enquiry, prepare quotations and, where you have agreed, send product and certification updates.</p>
    <p>Our web server records the IP address, browser type and pages visited in standard access logs, which we keep for 90 days for security and performance monitoring. This site does not use advertising cookies or third-party analytics.</p>
    <h2>Legal basis</h2>
    <p>We process enquiry data to take steps at your request before entering a contract, and on the basis of our legitimate interest in responding to business enquiries. Marketing emails are sent only with your consent, which you can withdraw at any time using the link in each email.</p>
    <h2>Sharing</h2>
    <p>Enquiry data is shared with our regional offices and, where you ask for a local supplier, with the appointed Kinston distributor for your country. We do not sell personal data.</p>
    <h2>Retention</h2>
    <p>Enquiry records are kept for three years after our last contact with you, or for the life of any resulting contract plus seven years for accounting purposes.</p>
    <h2>Your rights</h2>
    <p>You may ask for a copy of your data, ask us to correct or delete it, or object to our processing of it. Contact us using the enquiry form and we will respond within 30 days.</p>
  </div></section>
</Base>
<style is:global>
  .legal h2 { font-size: 1.5rem; margin: 2em 0 0.6em; }
  .legal h2:first-child { margin-top: 0; }
  .legal a { color: var(--navy); text-decoration: underline; }
</style>
