---
import Base from '../layouts/Base.astro';
import ProductCard from '../components/ProductCard.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import { site, sectors, certifications, stats } from '../data/site';
import { allCategoriesWithCounts, featuredProducts } from '../data/products';
import { latestArticles } from '../data/news';

const cats = allCategoriesWithCounts();
const featured = featuredProducts().slice(0, 4);
const news = latestArticles(3);
const sectorIcons = ['construction', 'offshore', 'marine', 'factory', 'power', 'mining', 'truck', 'wind'];
const fmtDate = (d: string) => new Date(d).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
---
<Base
  title="Kinston Lifting | Certified lifting chain, hooks, shackles and hoists"
  description={site.description}
  path="/"
>
  <section class="hero video-hero">
    <video class="hero-video" autoplay muted loop playsinline preload="metadata" poster="/videos/kinston-hero-poster.jpg" aria-hidden="true" tabindex="-1">
      <source src="/videos/kinston-hero.mp4" type="video/mp4" />
    </video>
    <div class="hero-video-shade" aria-hidden="true"></div>
    <div class="wrap hero-inner">
      <div class="hero-copy">
        <p class="eyebrow"><span></span> Kinston Lifting · Since {site.founded}</p>
        <h1>Behind every lift.<br /><em class="hot">Confidence.</em></h1>
        <p class="hero-intro">We make and supply certified lifting equipment for the work that matters.</p>
        <p class="lede">Grade 100 and Grade 80 chain slings, hooks, shackles, master links, wire rope fittings and hoists. Every item is proof tested, marked and traceable to its heat number before it leaves us.</p>
        <div class="hero-actions">
          <a class="btn" href="/products">Explore our products <Icon name="arrow" /></a>
          <a class="btn btn-outline-light" href="/contact">Talk to an engineer</a>
        </div>
        <ul class="proof">
          <li><Icon name="shield" /> EN 1677 and ASME B30 compliant</li>
          <li><Icon name="gauge" /> Proof loaded to 2.5 × WLL</li>
          <li><Icon name="tag" /> Serial numbered with certificate</li>
        </ul>
      </div>
      <a class="hero-scroll" href="#discover">Discover Kinston <Icon name="arrow" /></a>
    </div>
    <div class="wrap hero-ranges">
      <ul>
        {cats.map((c) => (
          <li><a href={`/products/${c.slug}`}>{c.short} <span>{c.count}</span></a></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="company-intro section" id="discover" aria-labelledby="intro-title">
    <div class="wrap intro-grid">
      <div><p class="eyebrow dark-label">THE STRENGTH BEHIND YOUR OPERATION</p><h2 id="intro-title">Your load. Our expertise.<br /><span>One trusted lifting partner.</span></h2></div>
      <div class="intro-copy"><p>From the first component to a complete lifting assembly, Kinston helps you move heavy loads with confidence. We manufacture, test and supply lifting equipment for construction, offshore, marine and industry worldwide.</p><a class="textlink" href="/about">Get to know Kinston <Icon name="arrow" /></a></div>
    </div>
    <div class="wrap intro-promises">
      <div><Icon name="shield" /><span><strong>Tested before it reaches you</strong><small>Proof tested, marked and certified</small></span></div>
      <div><Icon name="globe" /><span><strong>Local support. Global reach.</strong><small>Sharjah · Mumbai · Rotterdam</small></span></div>
      <div><Icon name="wrench" /><span><strong>Expertise for your next lift</strong><small>Product selection and sling design</small></span></div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <SectionHeading title="The right equipment. For every lift." lead="Choose a range to see every product with dimensions, working load limits and downloads." />
      <ul class="ranges" data-reveal>
        {cats.map((c, i) => (
          <li>
            <a href={`/products/${c.slug}`}>
              <div class="range-art"><span class="range-index" aria-hidden="true">0{i + 1} / KINSTON</span><img src={c.image ?? `/images/categories/branded/${c.slug}.webp`} alt={`Representative ${c.short.toLowerCase()} equipment`} loading="lazy" decoding="async" width="768" height="768" /><span class="range-browse">Explore range <Icon name="arrow" /></span></div>
              <div class="range-body">
                <h3>{c.name}</h3>
                <p>{c.groups.map((g) => (/^[A-Z][a-z]/.test(g) ? g[0].toLowerCase() + g.slice(1) : g)).join(', ')}</p>
                <div class="range-foot">
                  <span>{c.count} products</span>
                  <span class="range-go"><Icon name="arrow" /></span>
                </div>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section bg-paper">
    <div class="wrap why">
      <div class="why-copy">
        <SectionHeading title="Trust is built into every component." />
        <p class="prose">A lifting component is only as good as the test certificate behind it. We forge, heat treat, test and mark under one quality system, so the hook in your hand matches the number on the certificate and the drawing on the datasheet.</p>
        <ul class="stats" data-reveal data-count>
          {stats.map((s) => (
            <li><strong data-value={s.value}>{s.value}</strong><span>{s.label}</span></li>
          ))}
        </ul>
      </div>
      <ol class="why-list" data-reveal>
        <li>
          <h3>Every item proof tested</h3>
          <p>Components are loaded to 2.5 times WLL and chain slings to 2 times WLL on calibrated beds, with the load trace stored against the serial number.</p>
        </li>
        <li>
          <h3>Traceable from heat to hook</h3>
          <p>Each forging carries a batch code that links to the steel heat number, heat treatment chart, magnetic particle inspection and proof test record.</p>
        </li>
        <li>
          <h3>Stock in three regions</h3>
          <p>Sharjah, Navi Mumbai and Rotterdam hold the full component range. Chain slings are assembled and proof tested at each site for same-week delivery.</p>
        </li>
        <li>
          <h3>Engineers on the phone</h3>
          <p>Send the load, the lift points and the environment. You get a sling design, product codes and a quotation within one working day.</p>
        </li>
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="feat-head">
        <SectionHeading title="Proven products. Ready to work." />
        <a class="textlink" href="/products">All products</a>
      </div>
      <div class="grid cols-4" data-reveal>
        {featured.map((p) => <ProductCard product={p} />)}
      </div>
    </div>
  </section>

  <section class="industry-section section" aria-labelledby="industry-title">
    <div class="wrap">
      <div class="industry-heading">
        <div><p class="industry-kicker"><span></span> INDUSTRIES WE SERVE</p><h2 id="industry-title">Different industries.<br />The same <em>confidence.</em></h2></div>
        <div class="industry-heading-copy"><p>From tower crane rigging to subsea release, our ranges are specified where downtime is expensive and inspection is strict.</p><a href="/industries" class="industry-link">Explore our industries <Icon name="arrow" /></a></div>
      </div>
      <div class="industry-layout">
        <a class="industry-feature" href="/industries" aria-label="Explore the industries Kinston serves">
          <img src="/images/industries/industrial-yard.webp" alt="Gantry cranes and steel structures in a maritime fabrication yard at dusk" width="800" height="1200" loading="lazy" decoding="async" />
          <span class="industry-feature-top"><span>KINSTON IN INDUSTRY</span><span class="industry-feature-arrow"><Icon name="arrow" /></span></span>
          <div class="industry-feature-copy"><span class="industry-feature-label">BUILT FOR THE REAL WORLD</span><h3>Where the work<br />never stands still.</h3><p>From the crane hook to the load.<br />A lifting partner you can count on.</p></div>
        </a>
        <ul class="sectors" data-reveal>
          {sectors.map((s, i) => (
            <li><a href={`/industries#${s.slug}`}>
              <div class="sector-top"><span class="sector-icon"><Icon name={sectorIcons[i]} /></span><span class="sector-number">0{i + 1}</span></div>
              <h3>{s.name}<span class="sector-arrow"><Icon name="arrow" /></span></h3>
              <p>{s.body}</p>
            </a></li>
          ))}
        </ul>
      </div>
      <div class="industry-foot"><span><Icon name="globe" /> Across industries. Around the world.</span><a href="/contact">Find the right equipment for your operation <Icon name="arrow" /></a></div>
    </div>
  </section>

  <section class="section bg-paper">
    <div class="wrap quality">
      <div>
        <SectionHeading title="Certified, audited, documented" lead="Our quality system is certified by DNV and our offshore ranges hold DNV type approval. Certificates are on the downloads page." />
        <a class="btn btn-navy" href="/quality">Quality and certification</a>
      </div>
      <ul class="certs" data-reveal>
        {certifications.map((c) => (
          <li>
            <strong>{c.code}</strong>
            <span>{c.title}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="feat-head">
        <SectionHeading title="News and technical notes" />
        <a class="textlink" href="/news">All news</a>
      </div>
      <ul class="news" data-reveal>
        {news.map((a) => (
          <li>
            <a href={`/news/${a.slug}`}>
              <p class="news-meta"><span class="tag tag-navy">{a.category}</span> <time datetime={a.date}>{fmtDate(a.date)}</time></p>
              <h3>{a.title}</h3>
              <p class="muted">{a.excerpt}</p>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="lift-help section">
    <div class="wrap help-inner">
      <div><p class="eyebrow">LET’S GET YOUR PROJECT MOVING</p><h2>Have a lift in mind?<br />Let’s find the right solution.</h2><p>Tell us what you’re lifting, where you’re working and when you need it. Our engineers will help with the equipment, specifications and quotation.</p></div>
      <div class="help-actions"><a class="btn" href="/contact">Discuss your requirements <Icon name="arrow" /></a><a href={`mailto:${site.email}`}>{site.email}</a></div>
    </div>
  </section>
  <CtaBand />
</Base>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.documentElement.classList.add('js');

  // Scroll reveal: children of [data-reveal] rise in with a stagger.
  const revealEls = document.querySelectorAll<HTMLElement>('[data-reveal]');
  revealEls.forEach((el) => Array.from(el.children).forEach((c, i) => (c as HTMLElement).style.setProperty('--i', String(i))));
  if (reduce || !('IntersectionObserver' in window)) {
    revealEls.forEach((el) => el.classList.add('in'));
  } else {
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
    }, { rootMargin: '0px 0px -10% 0px', threshold: 0.12 });
    revealEls.forEach((el) => io.observe(el));
  }

  const video = document.querySelector<HTMLVideoElement>('.hero-video');
  if (video) {
    video.muted = true;
    if (reduce) video.pause();
    else video.play().catch(() => {});
  }

  // Count-up for the stats strip.
  const counters = document.querySelectorAll<HTMLElement>('[data-count] [data-value]');
  const run = (el: HTMLElement) => {
    const raw = el.dataset.value ?? '';
    const num = parseFloat(raw.replace(/[^0-9.]/g, ''));
    const prefix = raw.match(/^[^0-9]*/)?.[0] ?? '';
    const suffix = raw.match(/[^0-9.,]*$/)?.[0] ?? '';
    if (Number.isNaN(num) || reduce) { el.textContent = raw; return; }
    const t0 = performance.now(); const dur = 1400;
    const step = (t: number) => {
      const k = Math.min(1, (t - t0) / dur); const e = 1 - Math.pow(1 - k, 3);
      el.textContent = prefix + Math.round(num * e).toLocaleString('en-GB') + suffix;
      if (k < 1) requestAnimationFrame(step); else el.textContent = raw;
    };
    requestAnimationFrame(step);
  };
  if (counters.length) {
    counters.forEach((el) => { if (!reduce) el.textContent = (el.dataset.value ?? '').replace(/[0-9]/g, '0'); });
    const io2 = new IntersectionObserver((entries) => {
      entries.forEach((e) => { if (e.isIntersecting) { run(e.target as HTMLElement); io2.unobserve(e.target); } });
    }, { threshold: 0.5 });
    counters.forEach((el) => io2.observe(el));
  }
</script>

<style>
  .hero { color: var(--white); overflow: hidden; position: relative; }
  .hero::before {
    content: ''; position: absolute; inset: -50% -10%; pointer-events: none;
    background:
      radial-gradient(60% 50% at 78% 55%, rgba(248,80,0,.16), transparent 70%),
      radial-gradient(40% 40% at 15% 20%, rgba(10,46,120,.45), transparent 70%);
    animation: drift 18s ease-in-out infinite alternate;
  }
  .hero-inner { position: relative; }
  @keyframes drift { from { transform: translate3d(0,0,0); } to { transform: translate3d(2%, 3%, 0); } }

  /* staggered entrance */
  .hero-copy > * { animation: rise .8s var(--ease) both; }
  .hero-copy > :nth-child(1) { animation-delay: .05s; }
  .hero-copy > :nth-child(2) { animation-delay: .15s; }
  .hero-copy > :nth-child(3) { animation-delay: .35s; }
  .hero-copy > :nth-child(4) { animation-delay: .5s; }
  .hero-copy > :nth-child(5) { animation-delay: .65s; }
  .hero-copy > .dim { transform-origin: left; animation-name: grow; }
  @keyframes rise { from { opacity: 0; transform: translateY(22px); } to { opacity: 1; transform: none; } }
  @keyframes grow { from { opacity: 0; transform: scaleX(0); } to { opacity: 1; transform: scaleX(1); } }

  /* sheen sweeping across the headline */
  .sheen {
    background: linear-gradient(105deg, #fff 0%, #fff 42%, #ffd9c4 48%, #fff 54%, #fff 100%);
    background-size: 260% 100%; background-position: 120% 0;
    -webkit-background-clip: text; background-clip: text; color: transparent;
    animation: rise .8s var(--ease) both, sheen 7s ease-in-out 1.4s infinite;
  }
  .hot {
    font-style: normal;
    background: linear-gradient(105deg, #ff9a5e 0%, #f85000 35%, #ffd0b5 50%, #f85000 65%, #ff9a5e 100%);
    background-size: 260% 100%; background-position: 120% 0;
    -webkit-background-clip: text; background-clip: text; color: transparent;
    animation: sheen 7s ease-in-out 1.6s infinite;
    filter: drop-shadow(0 0 18px rgba(248,80,0,.35));
  }
  @keyframes sheen { 0%, 55% { background-position: 120% 0; } 85%, 100% { background-position: -40% 0; } }

  /* hook: float + glow */
  .hero-glow {
    position: absolute; inset: 12% 8% 6% 8%; border-radius: 50%; pointer-events: none;
    background: radial-gradient(closest-side, rgba(248,80,0,.28), rgba(248,80,0,.06) 60%, transparent 75%);
    filter: blur(24px); animation: pulse 6s ease-in-out infinite;
  }
  .hero-fig img { position: relative; animation: rise 1s var(--ease) .2s both; }
  .hook { padding: 10%; transform-origin: 50% 8%; transition: transform 2.6s cubic-bezier(.4,0,.6,1); }
  .hero-fig.loading .hook { transform: scaleY(1.018) translateY(4px); }
  .hero-heat {
    position: absolute; inset: 30% 10% 8% 10%; border-radius: 50%; pointer-events: none; opacity: 0;
    background: radial-gradient(closest-side, rgba(248,80,0,.55), rgba(248,80,0,.12) 55%, transparent 75%);
    filter: blur(28px); transition: opacity 2.4s ease;
  }
  .hero-fig.loading .hero-heat { opacity: 1; }

  /* proof test readout */
  .bench {
    position: absolute; right: -8px; top: 2%; width: 236px; padding: 16px 18px 18px; z-index: 2;
    border-radius: 6px; background: rgba(8,16,38,.78); border: 1px solid rgba(255,255,255,.12);
    backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
    box-shadow: 0 30px 60px -24px rgba(0,0,0,.7);
    animation: rise .8s var(--ease) 1.3s both;
  }
  .bench-head { display: flex; align-items: center; gap: 8px; font-size: var(--t-xs); color: #c3cbdb; }
  .bench-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--orange); animation: ping 1.1s ease-out infinite; }
  .bench.passed .bench-dot { background: #43d17a; animation: none; }
  @keyframes ping { 0% { box-shadow: 0 0 0 0 rgba(248,80,0,.6); } 100% { box-shadow: 0 0 0 9px rgba(248,80,0,0); } }
  .bench-load { display: flex; align-items: baseline; gap: 7px; margin-top: 8px; font-family: var(--font-display); font-weight: 600; font-size: 2.75rem; line-height: 1; color: var(--white); font-variant-numeric: tabular-nums; }
  .bench-unit { font-size: 1rem; font-weight: 500; color: #c3cbdb; }
  .bench-bar { position: relative; height: 6px; margin: 14px 0 28px; background: rgba(255,255,255,.12); border-radius: 3px; }
  .bench-fill { position: absolute; inset: 0 auto 0 0; width: calc(var(--p, 0) * 100%); border-radius: 3px; background: linear-gradient(90deg, #ff9a5e, var(--orange)); box-shadow: 0 0 12px rgba(248,80,0,.5); }
  .bench.passed .bench-fill { background: linear-gradient(90deg, #43d17a, #2fb868); box-shadow: 0 0 12px rgba(67,209,122,.4); transition: background .4s, box-shadow .4s; }
  .bench-tick { position: absolute; left: var(--at); top: -4px; width: 1px; height: 14px; background: rgba(255,255,255,.55); }
  .bench-tick i { position: absolute; top: 15px; left: 0; transform: translateX(-50%); font-style: normal; font-size: 11px; white-space: nowrap; color: #8a95a8; }
  .bench-tick:last-child i { transform: translateX(-100%); }
  .bench-meta { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin: 0; padding-top: 12px; border-top: 1px solid rgba(255,255,255,.1); }
  .bench-meta dt { font-size: 11px; color: #8a95a8; }
  .bench-meta dd { margin: 0; font-size: var(--t-xs); font-weight: 500; color: var(--white); }
  .bench-stamp {
    position: absolute; top: -15px; right: 14px; display: inline-flex; align-items: center; gap: 6px; padding: 5px 10px;
    border: 2px solid #43d17a; color: #43d17a; border-radius: 4px; background: rgba(8,16,38,.9);
    font-family: var(--font-display); font-weight: 700; font-size: .95rem; letter-spacing: .04em;
    transform: rotate(-6deg) scale(.5); opacity: 0; transition: transform .4s cubic-bezier(.2,1.5,.4,1), opacity .2s;
  }
  .bench.passed .bench-stamp { transform: rotate(-6deg) scale(1); opacity: 1; }
  .bench-stamp :global(svg) { width: 14px; height: 14px; stroke-width: 3; }

  /* range strip */
  .hero-ranges { position: relative; border-top: 1px solid rgba(255,255,255,.12); margin-top: 8px; }
  .hero-ranges ul { display: flex; gap: 4px 28px; padding: 18px 0 22px; overflow-x: auto; scrollbar-width: none; }
  .hero-ranges ul::-webkit-scrollbar { display: none; }
  .hero-ranges li { flex: none; }
  .hero-ranges a { font-family: var(--font-display); font-weight: 600; font-size: 1.0625rem; color: #dfe4ee; white-space: nowrap; transition: color .15s; }
  .hero-ranges a span { font-family: var(--font-body); font-weight: 500; font-size: var(--t-xs); color: var(--steel-light); margin-left: 3px; }
  .hero-ranges a:hover { color: var(--orange); }
  .hero-fig { animation: float 8s ease-in-out 1.2s infinite; }
  @keyframes float { 0%, 100% { transform: translateY(0) rotate(0deg); } 50% { transform: translateY(-12px) rotate(-1deg); } }
  @keyframes pulse { 0%, 100% { opacity: .75; transform: scale(.96); } 50% { opacity: 1; transform: scale(1.04); } }

  .hero-inner { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 48px; align-items: center; min-height: 640px; padding-block: 64px; }
  .hero h1 { color: var(--white); margin: 18px 0 22px; max-width: 15ch; font-size: clamp(2.75rem, 6vw, 5rem); text-wrap: balance; }
  .hero .lede { color: #c3cbdb; max-width: 54ch; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 32px; }
  .proof { display: flex; flex-wrap: wrap; gap: 10px 28px; margin-top: 40px; font-size: var(--t-sm); color: #c3cbdb; }
  .proof li { display: inline-flex; align-items: center; gap: 8px; }
  .proof :global(svg) { width: 18px; height: 18px; color: var(--orange); }
  .hero-art-wrap { position: relative; max-width: 600px; justify-self: end; width: 100%; }
  .hero-fig { position: relative; margin: 0; }
  .hero-fig img { width: 100%; height: auto; filter: drop-shadow(0 30px 40px rgba(0,0,0,.45)); }
  .dims { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
  .dt { font-family: var(--font-display); font-weight: 600; font-size: 40px; fill: var(--white); stroke: none; opacity: 0; animation: fade .5s ease 1.6s forwards; }
  .dl { stroke-dasharray: 900; stroke-dashoffset: 900; animation: draw 1.4s var(--ease) .7s forwards; }
  @keyframes draw { to { stroke-dashoffset: 0; } }
  @keyframes fade { to { opacity: 1; } }
  @media (prefers-reduced-motion: reduce) { .dl { stroke-dashoffset: 0; animation: none; } .dt { opacity: 1; animation: none; } }

  .ranges { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 20px; padding-top: 16px; }
  .ranges a {
    display: grid; grid-template-rows: auto 1fr; height: 100%;
    background: var(--white); border-radius: 6px;
    box-shadow: 0 0 0 1px rgba(17,27,51,.06), 0 2px 4px rgba(17,27,51,.04), 0 24px 40px -28px rgba(17,27,51,.28);
    transition: transform .45s var(--ease), box-shadow .45s var(--ease);
  }
  .ranges a:hover { transform: translateY(-6px); box-shadow: 0 0 0 1px rgba(17,27,51,.06), 0 6px 10px -4px rgba(17,27,51,.08), 0 40px 56px -28px rgba(10,46,120,.35); }
  .range-art {
    position: relative; aspect-ratio: 4 / 3; border-radius: 6px 6px 0 0;
    background: linear-gradient(180deg, var(--white) 0%, var(--zinc-light) 100%);
  }
  .range-art::after { content: ''; position: absolute; inset: 0; border-radius: inherit; background: radial-gradient(60% 50% at 50% 100%, rgba(248,80,0,.10), transparent 70%); opacity: 0; transition: opacity .45s var(--ease); }
  .ranges a:hover .range-art::after { opacity: 1; }
  .range-art img { position: absolute; left: 8%; width: 84%; top: -8%; height: 100%; object-fit: contain; mix-blend-mode: multiply; z-index: 1; transition: transform .5s var(--ease); }
  .ranges a:hover .range-art img { transform: translateY(-10px) scale(1.04) rotate(-1.5deg); }
  .range-body { display: grid; grid-template-rows: auto 1fr auto; padding: 16px 20px 16px; }
  .range-body h3 { font-size: 1.375rem; line-height: 1.08; letter-spacing: -0.015em; text-wrap: balance; }
  .range-body p { margin-top: 5px; font-size: var(--t-xs); line-height: 1.4; color: var(--steel); }
  .range-foot { display: flex; justify-content: space-between; align-items: center; margin-top: 14px; padding-top: 10px; border-top: 1px solid var(--zinc); font-size: var(--t-xs); font-weight: 500; color: var(--navy); }
