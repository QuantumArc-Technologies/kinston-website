---
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import CtaBand from '../../components/CtaBand.astro';
import ProductCard from '../../components/ProductCard.astro';
import ProductRail from '../../components/ProductRail.astro';
import { products } from '../../data/products';
import { breadcrumbLd } from '../../lib/seo';

const crumbs = [{ name: 'Home', href: '/' }, { name: 'Products', href: '/products' }];
---
<Base
  title="Grade 100 Rigging | Products"
  description="Explore Kinston Grade 100 rigging products. Browse hooks, master links, connectors and lifting points, review specifications and request a quote."
  path="/products"
  jsonLd={[breadcrumbLd(crumbs)]}
>
  <section class="page-head bg-ink">
    <div class="wrap">
      <Breadcrumb items={crumbs} light />
      <h1>Products</h1>
      <p class="lede">Explore our Grade 100 rigging products. Browse the full range, review specifications and working load limits, and request a quote.</p>
    </div>
  </section>

  <section class="section-tight">
    <div class="wrap catalogue-layout">
      <div class="catalogue-sidebar"><ProductRail /></div>
      <div class="catalogue-content" id="grade-100">
      <div class="range-heading">
        <h2>Grade 100 Rigging</h2>
        <p class="muted">{products.length} products</p>
      </div>
      <p class="range-description">Our Grade 100 rigging range includes alloy steel hooks, connecting links and master links for compatible Grade 100 chain assemblies. Forged or welded components support demanding applications in oilfields, mining and ports. Explore each product for dimensions, working load limits and available configurations.</p>
      <div class="grid product-grid">
        {products.map((product) => <ProductCard product={product} compact showColourSwitch={false} showFooter={false} />)}
      </div>
      </div>
    </div>
  </section>
  <CtaBand title="Can't see what you need?" body="We build bespoke assemblies, non-standard lengths and special finishes. Send a drawing or a description and we will quote it." />
</Base>

<style>
  .catalogue-layout { max-width: 1600px; display: grid; grid-template-columns: max-content minmax(0, 1fr); gap: 36px; align-items: start; }
  .catalogue-content { min-width: 0; scroll-margin-top: 150px; }
  .catalogue-sidebar { display: contents; }
  .range-heading { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 12px; margin-bottom: 20px; }
  .range-heading h2 { font-size: 1.75rem; }
  .range-heading p { font-size: 13px; }
  .range-description { margin: -6px 0 22px; max-width: 90ch; font-size: 13px; line-height: 1.7; color: var(--steel); }
  .product-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px; }
  @media (max-width: 1100px) { .catalogue-layout { grid-template-columns: 210px minmax(0, 1fr); gap: 24px; } .product-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 760px) { .catalogue-layout { grid-template-columns: 1fr; } .catalogue-sidebar { display: none; } }
  @media (max-width: 480px) {
    .product-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
    .product-grid :global(.compact .body) { padding: 9px; }
    .product-grid :global(.compact h3) { font-size: 14px; }
    .product-grid :global(.compact .code) { font-size: 10px; }
    .product-grid :global(.compact .collection) { top: 7px; left: 7px; font-size: 7px; padding: 3px 4px; }
  }
</style>
