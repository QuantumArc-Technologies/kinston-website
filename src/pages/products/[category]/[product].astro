---
import Base from '../../../layouts/Base.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import ProductCard from '../../../components/ProductCard.astro';
import ProductGallery from '../../../components/ProductGallery.astro';
import SpecTable from '../../../components/SpecTable.astro';
import EnquiryForm from '../../../components/EnquiryForm.astro';
import Icon from '../../../components/Icon.astro';
import { categoryBySlug } from '../../../data/categories';
import { products, relatedProducts, wllRange } from '../../../data/products';
import { breadcrumbLd, productLd } from '../../../lib/seo';
import { fmt } from '../../../lib/units';

export function getStaticPaths() {
  return products.map((p) => ({ params: { category: p.category, product: p.slug }, props: { product: p } }));
}
const { product: p } = Astro.props;
const cat = categoryBySlug(p.category)!;
const related = relatedProducts(p, 4);
const range = wllRange(p);
const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Products', href: '/products' },
  { name: cat.name, href: `/products/${cat.slug}` },
  { name: p.name, href: `/products/${cat.slug}/${p.slug}` },
];
const sizes = p.specRows.length;
---
<Base
  title={`${p.name} ${p.code}`}
  description={p.specificationNote || p.technicalNote ? `${p.summary} Explore model variants and request specifications.` : `${p.summary} ${sizes} sizes${range ? `, WLL ${fmt(range.min, 2)} to ${fmt(range.max, 2)} t` : ''}. Standards: ${p.standards.join(', ')}. Datasheet and certificate downloads.`}
  path={`/products/${cat.slug}/${p.slug}`}
  ogType="product"
  jsonLd={[breadcrumbLd(crumbs), productLd(p)]}
>
  <section class="section-tight">
    <div class="wrap">
      <Breadcrumb items={crumbs} />
      <div class="top">
        <ProductGallery product={p} />

        <div class="summary">
          <p class="code">{p.code}{p.grade && <span class="tag tag-orange">{p.grade}</span>}</p>
          <h1>{p.name}</h1>
          <p class="lede">{p.summary}</p>
          {p.usageNotice && <p class="usage-notice"><Icon name="shield" /> {p.usageNotice}</p>}

          <dl class="facts">
            {range && <div><dt>Working load limit</dt><dd>{fmt(range.min, 2)}{range.min !== range.max && ` to ${fmt(range.max, 2)}`} t</dd></div>}
            <div><dt>{p.specificationNote ? 'Model variants' : 'Sizes'}</dt><dd>{sizes}</dd></div>
            {p.specificationNote ? <div><dt>Specifications</dt><dd>Available on enquiry</dd></div> : <>
              <div><dt>Design factor</dt><dd>{p.designFactor}</dd></div>
              {p.standards.length > 0 && <div><dt>Standards</dt><dd>{p.standards.join(', ')}</dd></div>}
              <div><dt>Material</dt><dd>{p.material}</dd></div>
              <div><dt>Finish</dt><dd>{p.finish}</dd></div>
              <div><dt>Temperature</dt><dd>{p.tempRange}</dd></div>
            </>}
          </dl>

          <div class="actions">
            <a class="btn" href="#enquire">Request a quote</a>
            <a class="btn btn-outline" href="#specifications">Specifications</a>
            {p.downloads[0] && <a class="dl-link" href={p.downloads[0].href}><Icon name="download" /> Datasheet (PDF)</a>}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section-tight bg-paper">
    <div class="wrap detail">
      <div class="prose">
        <span class="dim" aria-hidden="true"></span>
        <h2>About this product</h2>
        {p.description.map((para) => <p>{para}</p>)}
      </div>
      <div class="features">
        <h3>Features</h3>
        <ul>
          {p.features.map((f) => <li><Icon name="check" /> {f}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="wrap">
      <SpecTable product={p} />
    </div>
  </section>

  <section class="section-tight bg-paper">
    <div class="wrap docs">
      <div>
        <span class="dim" aria-hidden="true"></span>
        <h2>Downloads</h2>
        <ul class="dl-list">
          {p.downloads.map((d) => (
            <li>
              <a href={d.href}>
                <Icon name="file" />
                <span class="dl-body"><strong>{d.label}</strong><span>{d.type} · PDF · {d.size}</span></span>
                <Icon name="download" class="dl-icon" />
              </a>
            </li>
          ))}
        </ul>
        {p.downloads.length === 0 && <p class="muted">Request the model datasheet, dimensions and available certification with your enquiry.</p>}
      </div>
      <div id="enquire">
        <EnquiryForm product={`${p.name} (${p.code})`} compact heading="Ask about this product" />
      </div>
    </div>
  </section>

  {related.length > 0 && (
    <section class="section-tight">
      <div class="wrap">
        <div class="rel-head">
          <span class="dim" aria-hidden="true"></span>
          <h2>Related products</h2>
          <a class="textlink" href={`/products/${cat.slug}`}>All {cat.short.toLowerCase()}</a>
        </div>
        <div class="grid cols-4">
          {related.map((r) => <ProductCard product={r} />)}
        </div>
      </div>
    </section>
  )}
</Base>

<style>
  .top { display: grid; grid-template-columns: 1fr 1fr; gap: 56px; margin-top: 28px; align-items: start; }


  .code { display: flex; align-items: center; gap: 12px; font-weight: 600; color: var(--navy); font-size: var(--t-sm); margin-bottom: 10px; }
  .summary h1 { font-size: clamp(2rem, 3.6vw, 2.75rem); margin-bottom: 14px; }
  .usage-notice { display: flex; align-items: center; gap: 10px; margin-top: 18px; padding: 14px 16px; background: var(--orange-soft); border-left: 3px solid var(--orange); font-weight: 600; }
  .usage-notice :global(svg) { width: 22px; height: 22px; flex: none; }
  .facts { display: grid; grid-template-columns: 1fr 1fr; gap: 0 24px; margin-top: 28px; border-top: 1px solid var(--zinc); }
  .facts div { display: grid; gap: 2px; padding: 12px 0; border-bottom: 1px solid var(--zinc); }
  .facts div:nth-child(1), .facts div:nth-child(4), .facts div:nth-child(5) { grid-column: 1 / -1; }
  .facts dt { font-size: var(--t-xs); color: var(--steel); }
  .facts dd { margin: 0; font-weight: 500; }
  .facts div:nth-child(1) dd { font-family: var(--font-display); font-weight: 700; font-size: 1.75rem; color: var(--orange-dark); }
  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: 14px; margin-top: 28px; }
  .dl-link { display: inline-flex; align-items: center; gap: 8px; font-weight: 500; color: var(--navy); }
  .dl-link :global(svg) { width: 18px; height: 18px; color: var(--orange); }

  .detail { display: grid; grid-template-columns: 1.3fr 1fr; gap: 56px; }
  .detail h2 { margin: 10px 0 18px; }
  .features { background: var(--white); border: 1px solid var(--zinc); border-radius: var(--radius); padding: 26px 28px; align-self: start; }
  .features h3 { margin-bottom: 14px; }
  .features li { display: flex; gap: 10px; align-items: flex-start; padding: 8px 0; border-top: 1px solid var(--zinc); }
  .features :global(svg) { width: 18px; height: 18px; color: var(--orange); flex: none; margin-top: 4px; }

  .docs { display: grid; grid-template-columns: 1fr 1fr; gap: 56px; align-items: start; }
  .docs h2 { margin: 10px 0 18px; }
  .dl-list { display: grid; gap: 10px; }
  .dl-list a { display: flex; align-items: center; gap: 14px; padding: 14px 16px; background: var(--white); border: 1px solid var(--zinc); border-radius: var(--radius); transition: border-color .15s; }
  .dl-list a:hover { border-color: var(--navy); }
  .dl-list :global(svg) { width: 22px; height: 22px; color: var(--navy); flex: none; }
  .dl-list :global(.dl-icon) { color: var(--orange); margin-left: auto; }
  .dl-body { display: grid; gap: 2px; }
  .dl-body span { font-size: var(--t-xs); color: var(--steel); }

  .rel-head { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; margin-bottom: 24px; }
  .rel-head h2 { margin-right: auto; }
  #enquire { scroll-margin-top: 140px; }

  @media (max-width: 960px) { .top, .detail, .docs { grid-template-columns: 1fr; gap: 32px; } }
  @media (max-width: 480px) { .facts { grid-template-columns: 1fr; } .facts div { grid-column: auto !important; } }
</style>
