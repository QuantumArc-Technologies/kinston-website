---
interface Props { title: string; lead?: string; align?: 'left' | 'center'; as?: 'h1' | 'h2' | 'h3'; }
const { title, lead, align = 'left', as = 'h2' } = Astro.props;
const Tag = as;
---
<div class:list={['sh', align]}>
  <span class="dim" aria-hidden="true"></span>
  <Tag>{title}</Tag>
  {lead && <p class="lede">{lead}</p>}
</div>
<style>
  .sh { display: grid; gap: 14px; margin-bottom: clamp(32px, 4vw, 48px); }
  .sh.center { justify-items: center; text-align: center; }
  .sh h1, .sh h2, .sh h3 { max-width: 20ch; }
  .sh.center h2 { max-width: 24ch; }
  .sh .lede { margin-top: 4px; }
</style>
