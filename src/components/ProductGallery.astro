---
import type { Product } from '../data/products';

interface Props { product: Product }
const { product } = Astro.props;
const image = product.image ?? `/images/products/branded/${product.slug}.webp`;
---
<div class="gallery" data-product-gallery>
  <figure class="main-art">
    <img data-gallery-image src={image} alt={product.name} width="1024" height="1024" fetchpriority="high" />
    <figcaption>{product.imageCaption ?? 'Representative product image · Refer to the datasheet for dimensions'}</figcaption>
  </figure>
</div>


<style>
  .gallery { display: grid; gap: 8px; }
  .main-art { margin: 0; overflow: hidden; background: #eef0f2; border: 1px solid var(--zinc); border-radius: 6px; aspect-ratio: 1; position: relative; }
  .main-art > img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; }
  figcaption { position: absolute; left: 16px; bottom: 12px; font-size: 8px; color: var(--steel); background: #ffffffe6; padding: 5px 8px; border-radius: 4px; max-width: calc(100% - 32px); }
</style>
