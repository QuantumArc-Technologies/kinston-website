---
// import { site } from '../data/site';
interface Props { title?: string; body?: string }
const {
  title = 'Tell us what you need to lift.',
  body = 'Send the load, the lift points and the environment. Our engineers reply within one working day with a sling design, product codes and a quotation.',
} = Astro.props;
---
<section class="cta blueprint">
  <div class="wrap cta-inner">
    <div>
      <span class="dim" aria-hidden="true"></span>
      <h2>{title}</h2>
      <p class="lede">{body}</p>
    </div>
    <div class="cta-actions">
      <a class="btn" href="/contact">Request a quote</a>
      {/* <a class="btn btn-outline-light" href={site.phoneHref}>Call {site.phone}</a> */}
    </div>
  </div>
</section>
<style>
  .cta { color: var(--white); padding-block: clamp(56px, 7vw, 96px); }
  .cta-inner { display: grid; grid-template-columns: 1.4fr 1fr; gap: 48px; align-items: center; }
  .cta h2 { color: var(--white); margin: 14px 0 16px; max-width: 18ch; }
  .cta .lede { color: #b7c0d2; }
  .cta-actions { display: flex; flex-wrap: wrap; gap: 14px; justify-content: flex-end; }
  @media (max-width: 860px) { .cta-inner { grid-template-columns: 1fr; } .cta-actions { justify-content: flex-start; } }
</style>
