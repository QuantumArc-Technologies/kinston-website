---
import { site } from '../data/site';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap">
    <div class="footer-top">
      <div class="brand">
        <a href="/" class="logo-plate" aria-label={`${site.name} home`}>
          <img src="/brand/kinston-logo.png" alt="Kinston — Lifting · Trust · Performance" width="1380" height="334" loading="lazy" />
        </a>
      </div>

    </div>

    <div class="footer-bottom">
      <p>© {year} {site.legalName}. All rights reserved.</p>
      <ul>
        <li><a href="/privacy">Privacy</a></li>
        <li><a href="/terms">Terms</a></li>
        <li><a href="/sitemap-index.xml">Sitemap</a></li>
      </ul>
    </div>
  </div>
</footer>

<style>
  .site-footer { background: var(--ink); color: #b7c0d2; padding-block: 28px 24px; font-size: var(--t-sm); }
  .footer-top { padding-bottom: 20px; border-bottom: 1px solid rgba(255,255,255,.12); }
  .logo-plate { display: inline-block; background: var(--white); padding: 12px 16px; border-radius: var(--radius); }
  .logo-plate img { height: 36px; width: auto; }
  .footer-bottom { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 12px 24px; padding-top: 20px; font-size: var(--t-xs); }
  .footer-bottom ul { display: flex; gap: 20px; }
  .footer-bottom a:hover { color: var(--white); }
</style>
