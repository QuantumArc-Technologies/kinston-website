---
import { site, offices } from '../data/site';
import { allCategoriesWithCounts } from '../data/products';
import Icon from './Icon.astro';
const year = new Date().getFullYear();
const categories = allCategoriesWithCounts();
---
<footer class="site-footer">
  <div class="wrap">
    <div class="footer-top">
      <div class="brand">
        <a href="/" class="logo-plate" aria-label={`${site.name} home`}>
          <img src="/brand/kinston-logo.png" alt="Kinston — Lifting · Trust · Performance" width="1380" height="334" loading="lazy" />
        </a>
        <p class="brand-text">Certified lifting chain, hooks, shackles, master links, wire rope fittings and hoists. Every item proof tested and traceable to its heat number.</p>
        <ul class="social">
          <li><a href={site.social.linkedin} aria-label="Kinston on LinkedIn" rel="noopener" target="_blank"><Icon name="linkedin" /></a></li>
          <li><a href={site.social.youtube} aria-label="Kinston on YouTube" rel="noopener" target="_blank"><Icon name="youtube" /></a></li>
          <li><a href={site.social.facebook} aria-label="Kinston on Facebook" rel="noopener" target="_blank"><Icon name="facebook" /></a></li>
        </ul>
      </div>

      <div class="col">
        <h4>Products</h4>
        <ul>
          {categories.map((c) => <li><a href={`/products/${c.slug}`}>{c.name}</a></li>)}
        </ul>
      </div>

      <div class="col">
        <h4>Company</h4>
        <ul>
          <li><a href="/about">About Kinston</a></li>
          <li><a href="/industries">Industries</a></li>
          <li><a href="/quality">Quality and certification</a></li>
          <li><a href="/news">News</a></li>
          <li><a href="/downloads">Downloads</a></li>
          <li><a href="/contact">Contact</a></li>
        </ul>
      </div>

      <div class="col offices">
        <h4>Offices</h4>
        <ul>
          {offices.map((o) => (
            <li>
              <strong>{o.city}, {o.country}</strong>
              <span>{o.role}</span>
              {/* <a href={`tel:${o.phone.replace(/\s/g, '')}`}>{o.phone}</a> */}
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="accred" aria-label="Accreditations">
      <span>ISO 9001:2015</span>
      <span>ISO 14001:2015</span>
      <span>ISO 45001:2018</span>
      <span>DNV type approval</span>
      <span>EN 1677</span>
      <span>LEEA member</span>
    </div>

    <div class="footer-bottom">
      <p>© {year} {site.legalName}. All rights reserved.</p>
      <ul>
        <li><a href="/privacy">Privacy</a></li>
        <li><a href="/terms">Terms</a></li>
        <li><a href="/sitemap-index.xml">Sitemap</a></li>
      </ul>
    </div>
  </div>
</footer>

<style>
  .site-footer { background: var(--ink); color: #b7c0d2; padding-block: 64px 28px; font-size: var(--t-sm); }
  .footer-top { display: grid; grid-template-columns: 1.4fr 1fr 0.8fr 1.2fr; gap: 48px; padding-bottom: 48px; border-bottom: 1px solid rgba(255,255,255,.12); }
  .logo-plate { display: inline-block; background: var(--white); padding: 12px 16px; border-radius: var(--radius); }
  .logo-plate img { height: 36px; width: auto; }
  .brand-text { margin-top: 20px; max-width: 40ch; line-height: 1.6; }
  .social { display: flex; gap: 10px; margin-top: 22px; }
  .social a { display: inline-flex; width: 38px; height: 38px; align-items: center; justify-content: center; border: 1px solid rgba(255,255,255,.2); border-radius: var(--radius); color: var(--white); transition: border-color .15s, background .15s; }
  .social a:hover { border-color: var(--orange); background: var(--orange); }
  .social :global(svg) { width: 18px; height: 18px; }
  .col h4 { color: var(--white); margin-bottom: 16px; font-size: var(--t-md); }
  .col li + li { margin-top: 9px; }
  .col a { color: #b7c0d2; transition: color .15s; }
  .col a:hover { color: var(--white); }
  .offices li { display: grid; gap: 2px; }
  .offices li + li { margin-top: 16px; }
  .offices strong { color: var(--white); font-weight: 500; }
  .accred { display: flex; flex-wrap: wrap; gap: 10px; padding-block: 28px; border-bottom: 1px solid rgba(255,255,255,.12); }
  .accred span { font-family: var(--font-display); font-weight: 600; font-size: var(--t-sm); color: var(--white); border: 1px solid rgba(255,255,255,.25); padding: 6px 12px; border-radius: var(--radius); }
  .footer-bottom { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 12px 24px; padding-top: 24px; font-size: var(--t-xs); }
  .footer-bottom ul { display: flex; gap: 20px; }
  .footer-bottom a:hover { color: var(--white); }
  @media (max-width: 1024px) { .footer-top { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 600px) { .footer-top { grid-template-columns: 1fr; gap: 36px; } }
</style>
