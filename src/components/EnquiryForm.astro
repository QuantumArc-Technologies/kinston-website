---
import Icon from './Icon.astro';
import { categories } from '../data/categories';
interface Props { product?: string; compact?: boolean; heading?: string }
const { product, compact = false, heading = 'Send an enquiry' } = Astro.props;
---
<form class:list={['enq', { compact, 'product-enquiry': Boolean(product) }]} method="post" action="https://formspree.io/f/placeholder" data-enquiry novalidate>
  <div class="form-intro">
    {product && <p class="form-eyebrow">PRODUCT ENQUIRY</p>}
    <h3>{heading}</h3>
    <p class="form-description">{product ? 'Tell us what you need. Our team will help with sizes, quantities and delivery.' : 'Replies within one working day. Fields marked * are required.'}</p>
    {product && <>
      <div class="product-reference"><span>Selected product</span><strong>{product}</strong></div>
      <p class="response-time"><Icon name="mail" /> Reply within one working day</p>
    </>}
  </div>
  <div class="form-fields">
  {product && <p class="fields-note">Your contact details <span>* Required fields</span></p>}
  <input type="hidden" name="product" value={product ?? ''} />
  <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="visually-hidden" aria-hidden="true" />

  <div class="row">
    <label>Name *<input type="text" name="name" placeholder={product ? 'Full name' : undefined} required autocomplete="name" /></label>
    <label>Company<input type="text" name="company" placeholder={product ? 'Company name' : undefined} autocomplete="organization" /></label>
  </div>
  <div class="row">
    <label>Email *<input type="email" name="email" placeholder={product ? 'you@company.com' : undefined} required autocomplete="email" /></label>
    <label>Phone<input type="tel" name="phone" placeholder={product ? '+971 …' : undefined} autocomplete="tel" /></label>
  </div>
  {!product && (
    <label>Product range
      <select name="range">
        <option value="">Not sure yet</option>
        {categories.map((c) => <option value={c.slug}>{c.name}</option>)}
      </select>
    </label>
  )}
  <label>Message *
    <textarea name="message" rows={compact ? 4 : 6} required placeholder={product ? 'Include sizes, quantities and your delivery location…' : 'Load, lift points, quantity and delivery location'}></textarea>
  </label>
  <div class="form-footer">
  <label class="consent"><input type="checkbox" name="consent" required /> <span>I agree to Kinston storing my details to answer this enquiry. See the <a href="/privacy">privacy policy</a>.</span></label>
  <button class="btn" type="submit">Send enquiry {product && <Icon name="arrow" />}</button>
  </div>
  <p class="status" role="status" aria-live="polite" data-status></p>
  </div>
</form>

<script>
  document.querySelectorAll<HTMLFormElement>('[data-enquiry]').forEach((form) => {
    const status = form.querySelector<HTMLElement>('[data-status]')!;
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      if (!form.checkValidity()) {
        form.reportValidity();
        status.textContent = 'Complete the required fields before sending.';
        status.dataset.state = 'error';
        return;
      }
      status.textContent = 'Enquiry sent. We will reply within one working day.';
      status.dataset.state = 'ok';
      form.reset();
    });
  });
</script>

<style>
  .enq { display: grid; gap: 16px; background: var(--white); border: 1px solid var(--zinc); border-radius: var(--radius); padding: 28px; }
  .enq h3 { margin-bottom: -8px; }
  .form-fields { display: grid; gap: 16px; min-width: 0; }
  .form-footer { display: grid; gap: 16px; }
  .form-description { font-size: 13px; color: var(--steel); margin-top: 12px; }
  .row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  label { display: grid; gap: 6px; font-size: var(--t-sm); font-weight: 500; color: var(--ink-2); }
  input[type='text']:not(.visually-hidden), input[type='email'], input[type='tel'], select, textarea {
    width: 100%; padding: 12px 14px; border: 1px solid #c7cedb; border-radius: var(--radius); background: var(--white); font-size: var(--t-base); font-weight: 400;
    transition: border-color .15s, box-shadow .15s;
  }
  input:focus, select:focus, textarea:focus { outline: none; border-color: var(--navy); box-shadow: 0 0 0 3px rgba(10,46,120,.15); }
  textarea { resize: vertical; }
  .consent { grid-template-columns: auto 1fr; align-items: start; font-weight: 400; color: var(--steel); }
  .consent input { margin-top: 4px; accent-color: var(--orange); }
  .consent a { color: var(--navy); text-decoration: underline; }
  .btn { justify-self: start; }
  .status:empty { display: none; }
  .status { font-size: var(--t-sm); min-height: 1.4em; }
  .status[data-state='ok'] { color: #1a7f4b; }
  .status[data-state='error'] { color: #b42318; }
  .enq.compact { padding: 20px; gap: 12px; border-radius: 6px; box-shadow: 0 3px 12px #111b3305; }
  .compact h3 { font-size: 24px; margin-bottom: 0; }
  .compact > p.small { font-size: 12px; }
  .compact .row { gap: 14px; }
  .compact label { font-size: 12px; gap: 5px; }
  .compact input[type='text']:not(.visually-hidden), .compact input[type='email'], .compact input[type='tel'], .compact select, .compact textarea { padding: 9px 11px; font-size: 13px; line-height: 1.4; border-radius: 4px; }
  .compact textarea { min-height: 96px; }
  .compact .consent { font-size: 11px; line-height: 1.5; }
  .compact .btn { min-height: 38px; padding: 9px 18px; font-size: 14px; border-radius: 4px; }
  .enq.product-enquiry { display: grid; grid-template-columns: minmax(200px, .7fr) minmax(0, 1.6fr); gap: 0; padding: 0; border: 1px solid #e0e5ed; border-radius: 12px; overflow: hidden; box-shadow: 0 8px 28px -16px #111b332b; }
  .product-enquiry .form-intro { display: flex; flex-direction: column; padding: 28px 24px; background: linear-gradient(145deg, #19243a, #233b60); color: white; border-top: 3px solid var(--orange); }
  .form-eyebrow { color: #ffad88; font-size: 10px; font-weight: 600; letter-spacing: .14em; margin-bottom: 14px; }
  .product-enquiry h3 { font-size: 27px; line-height: 1.15; color: white; }
  .product-enquiry .form-description { font-size: 12px; line-height: 1.7; color: #c5d0df; margin-top: 12px; }
  .product-reference { margin-block: 24px; padding-block: 16px; border-block: 1px solid #ffffff26; }
  .product-reference span { display: block; font-size: 10px; color: #b6c5d8; margin-bottom: 6px; }
  .product-reference strong { display: block; font-size: 13px; line-height: 1.6; font-weight: 500; }
  .response-time { display: flex; align-items: center; gap: 8px; margin-top: auto; font-size: 11px; color: #d7e2f0; }
  .response-time :global(svg) { width: 15px; height: 15px; color: #ffad88; flex: none; }
  .product-enquiry .form-fields { padding: 24px; gap: 14px; }
  .fields-note { display: flex; align-items: center; justify-content: space-between; gap: 8px; font-size: 13px; font-weight: 600; color: var(--ink); }
  .fields-note span { font-size: 10px; color: var(--steel); font-weight: 400; }
  .product-enquiry label { font-size: 12px; gap: 6px; }
  .product-enquiry input[type='text']:not(.visually-hidden), .product-enquiry input[type='email'], .product-enquiry input[type='tel'], .product-enquiry textarea { background: #f8fafc; border-color: #dce2eb; border-radius: 6px; padding: 10px 12px; font-size: 13px; }
  .product-enquiry input::placeholder, .product-enquiry textarea::placeholder { color: #919bab; }
  .product-enquiry input:focus, .product-enquiry textarea:focus { background: white; border-color: var(--navy); }
  .product-enquiry textarea { min-height: 100px; }
  .product-enquiry .form-footer { padding-top: 14px; border-top: 1px solid #e8ecf2; gap: 14px; }
  .product-enquiry .consent { font-size: 10px; line-height: 1.6; }
  .product-enquiry .btn { min-height: 40px; padding: 9px 16px; border-radius: 6px; font-size: 14px; gap: 24px; }
  .product-enquiry .btn :global(svg) { width: 16px; height: 16px; }
  @media (max-width: 1050px) { .enq.product-enquiry { grid-template-columns: 1fr; } .product-enquiry .form-intro { padding: 20px; } .product-reference { margin-block: 14px; padding-block: 12px; } .product-enquiry .form-fields { padding: 20px; } }
  @media (max-width: 560px) { .product-enquiry .row { grid-template-columns: 1fr; } .product-enquiry input[type='text']:not(.visually-hidden), .product-enquiry input[type='email'], .product-enquiry input[type='tel'], .product-enquiry textarea { font-size: 16px; } }
  @media (max-width: 560px) { .row { grid-template-columns: 1fr; } .enq { padding: 20px; } }
</style>
