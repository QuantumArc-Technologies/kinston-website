---
import type { Product } from '../data/products';
import { productUrl } from '../data/products';
import { grade100Products } from '../data/grade-100-products';
import Icon from './Icon.astro';

interface Props { product: Product; showCategory?: string; compact?: boolean; showFooter?: boolean }
const { product, compact = false } = Astro.props;
const img = product.image ?? `/images/products/branded/${product.slug}.webp`;
const inGrade100Range = grade100Products.some(({ slug }) => slug === product.slug);
const updatedCard = inGrade100Range || product.grade === 'Grade 80';
---
<article class:list={["card", { compact, 'updated-product-card': updatedCard }]} data-product-card data-group={product.group} data-grade={product.grade ?? ''}>
  <button class="removal-toggle" type="button" data-removal-product data-product-name={product.name} data-product-url={productUrl(product)} aria-label={`Request removal of ${product.name}`} aria-pressed="false" title="Add to removal list"><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg></button>
  <div class="art"><img data-card-image src={img} alt={product.name} loading="lazy" decoding="async" width="768" height="768" /><span class="browse">View product <Icon name="arrow" /></span></div>
  <div class="body">
    <h3><a class="product-link" href={productUrl(product)}>{product.name}</a></h3>
  </div>
</article>

<style>
  .removal-toggle { position: absolute; top: 10px; right: 10px; z-index: 2; display: grid; place-items: center; width: 32px; height: 32px; padding: 0; border: 1px solid #111b3314; border-radius: 8px; background: #ffffffed; color: #526077; cursor: pointer; transition: background .2s, color .2s; }
  .card[data-removal-hidden] { display: none; }
  .removal-toggle:hover { background: #fff0ec; color: #b42318; }
  .removal-toggle[aria-pressed='true'] { background: #b42318; color: white; border-color: #b42318; }
  .removal-toggle:focus-visible { outline: 3px solid var(--orange); outline-offset: 3px; }
  .card { position: relative; display: grid; grid-template-rows: auto 1fr; background: var(--white); border: 1px solid #e2e5e9; border-radius: 12px; overflow: hidden; box-shadow: 0 4px 16px #111b3304; transition: border-color .35s, transform .35s var(--ease), box-shadow .35s var(--ease); }
  .card[hidden] { display: none; }
  .card:hover, .card:focus-within { border-color: #f8500060; transform: translateY(-7px); box-shadow: 0 18px 36px -16px #111b3338; }
  .product-link::after { content: ''; position: absolute; inset: 0; z-index: 1; }
  .product-link:focus-visible { outline: 2px solid var(--navy); outline-offset: 3px; }
  .art { position: relative; background: #eef0f2; aspect-ratio: 1; border-bottom: 1px solid #e9ecef; overflow: hidden; }
  .art img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform .65s var(--ease); }
  .card:hover .art img { transform: scale(1.055); }
  .browse { position: absolute; bottom: 16px; left: 16px; right: 16px; display: flex; justify-content: space-between; align-items: center; padding: 11px 14px; background: #111b33ed; color: white; border-radius: 6px; font-size: 12px; opacity: 0; transform: translateY(8px); transition: opacity .25s, transform .25s; }
  .browse :global(svg) { width: 16px; }
  .card:hover .browse, .card:focus-within .browse { opacity: 1; transform: none; }
  .body { padding: 16px 17px 13px; display: flex; flex-direction: column; gap: 7px; }
  h3 { font-size: 1.25rem; line-height: 1.15; transition: color .2s; }
  .card:hover h3 { color: var(--orange); }
  .compact .body { padding: 12px; gap: 6px; }
  .compact h3 { font-size: 1.05rem; line-height: 1.25; }
  .updated-product-card .body { justify-content: center; text-align: center; }
  .updated-product-card h3 { font-size: .9375rem; line-height: 1.3; }
  @media (hover: none) { .browse { display: none; } }
  @media (prefers-reduced-motion: reduce) { .card, .art img, .browse { transition: none; } .card:hover, .card:hover .art img { transform: none; } }
</style>
