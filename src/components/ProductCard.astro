---
import type { Product } from '../data/products';
import { productUrl, wllRange } from '../data/products';
import Icon from './Icon.astro';
import { fmt } from '../lib/units';

interface Props { product: Product; showCategory?: string; compact?: boolean; showFooter?: boolean }
const { product, showCategory, compact = false, showFooter = true } = Astro.props;
const range = wllRange(product);
const img = product.image ?? `/images/products/branded/${product.slug}.webp`;
---
<article class:list={["card", { compact }]} data-product-card data-group={product.group} data-grade={product.grade ?? ''}>
  <div class="art"><span class="collection">KINSTON / {product.code}</span><img data-card-image src={img} alt={product.name} loading="lazy" decoding="async" width="768" height="768" /><span class="browse">View product <Icon name="arrow" /></span></div>
  <div class="body">
    <p class="code">{product.code}{product.grade && <span> · {product.grade}</span>}</p>
    <h3><a class="product-link" href={productUrl(product)}>{product.name}</a></h3>
    {range && (
      <p class="wll">
        WLL {fmt(range.min, 2)}{range.min !== range.max && ` to ${fmt(range.max, 2)}`} t
      </p>
    )}
    {showCategory && <p class="cat">{showCategory}</p>}
    {showFooter && <div class="card-foot">
      <span>Specifications &amp; details</span>
      <span class="card-arrow"><Icon name="arrow" /></span>
    </div>}
  </div>
</article>

<style>
  .card { position: relative; display: grid; grid-template-rows: auto 1fr; background: var(--white); border: 1px solid #e2e5e9; border-radius: 12px; overflow: hidden; box-shadow: 0 4px 16px #111b3304; transition: border-color .35s, transform .35s var(--ease), box-shadow .35s var(--ease); }
  .card[hidden] { display: none; }
  .card:hover, .card:focus-within { border-color: #f8500060; transform: translateY(-7px); box-shadow: 0 18px 36px -16px #111b3338; }
  .product-link::after { content: ''; position: absolute; inset: 0; z-index: 1; }
  .product-link:focus-visible { outline: 2px solid var(--navy); outline-offset: 3px; }
  .art { position: relative; background: #eef0f2; aspect-ratio: 1; border-bottom: 1px solid #e9ecef; overflow: hidden; }
  .art img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform .65s var(--ease); }
  .card:hover .art img { transform: scale(1.055); }
  .collection { position: absolute; top: 16px; left: 16px; z-index: 1; color: #4c596b; background: #ffffffc9; border: 1px solid #ffffff90; border-radius: 4px; padding: 5px 8px; font-size: 9px; font-weight: 600; letter-spacing: .1em; }
  .browse { position: absolute; bottom: 16px; left: 16px; right: 16px; display: flex; justify-content: space-between; align-items: center; padding: 11px 14px; background: #111b33ed; color: white; border-radius: 6px; font-size: 12px; opacity: 0; transform: translateY(8px); transition: opacity .25s, transform .25s; }
  .browse :global(svg) { width: 16px; }
  .card:hover .browse, .card:focus-within .browse { opacity: 1; transform: none; }
  .body { padding: 16px 17px 13px; display: flex; flex-direction: column; gap: 7px; }
  .code { font-size: var(--t-xs); color: var(--steel); font-weight: 500; }
  .code span { color: var(--navy); }
  h3 { font-size: 1.25rem; line-height: 1.15; transition: color .2s; }
  .card:hover h3 { color: var(--orange); }
  .wll { font-size: var(--t-sm); color: var(--ink-2); font-weight: 500; }
  .cat { font-size: var(--t-xs); color: var(--steel); }
  .card-foot { display: flex; justify-content: space-between; align-items: center; gap: 10px; border-top: 1px solid var(--zinc); padding-top: 10px; margin-top: auto; font-size: 11px; color: var(--steel); }
  .wll, .cat { margin-bottom: 4px; }
  .card-arrow { display: grid; place-items: center; width: 28px; height: 28px; border-radius: 50%; background: #f0f2f5; color: var(--ink); transition: background .25s, color .25s; flex: none; }
  .card-arrow :global(svg) { width: 16px; }
  .card:hover .card-arrow { background: var(--orange); color: white; }
  .compact .body { padding: 12px; gap: 6px; }
  .compact h3 { font-size: 1.05rem; line-height: 1.25; }
  .compact .code { font-size: 11px; }
  .compact .wll { font-size: 12px; }
  .compact .collection { top: 10px; left: 10px; font-size: 8px; padding: 4px 6px; }
  .compact .card-foot { font-size: 10px; gap: 6px; }
  @media (hover: none) { .browse { display: none; } }
  @media (prefers-reduced-motion: reduce) { .card, .art img, .browse { transition: none; } .card:hover, .card:hover .art img { transform: none; } }
</style>
